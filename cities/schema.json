{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "City config",
  "type": "object",
  "required": ["id", "name", "bbox", "center", "locale", "geocoder", "gtfs", "modes", "window"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[west, south, east, north]"
    },
    "center": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" },
      "description": "[lat, lon]"
    },
    "zoom": { "type": "number" },
    "locale": { "type": "string", "minLength": 2 },
    "geocoder": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "pattern": "^https?://" },
        "lang": { "type": "string", "minLength": 2, "description": "Only if the provider supports it (Photon rejects es)" },
        "contact": { "type": "string", "description": "Optional contact e-mail sent to Nominatim to identify the app" },
        "reverse": {
          "type": "object",
          "required": ["provider", "endpoint"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "endpoint": { "type": "string", "pattern": "^https?://" }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "required": ["osm_relation_id"],
      "additionalProperties": false,
      "properties": { "osm_relation_id": { "type": "integer", "minimum": 1 } }
    },
    "gtfs": {
      "type": "object",
      "required": ["sources", "license", "attribution"],
      "additionalProperties": false,
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["walk", "transit"] },
          "speed_m_per_min": { "type": "number", "exclusiveMinimum": 0 },
          "detour_factor": { "type": "number", "minimum": 1 },
          "max_access_m": { "type": "number", "minimum": 0 },
          "max_transfer_walk_m": { "type": "number", "minimum": 0 },
          "route_types": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
          "wait": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "factor": { "type": "number", "minimum": 0 },
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 }
            }
          },
          "transfer_min": { "type": "number", "minimum": 0 },
          "enabled_default": { "type": "boolean" }
        },
        "if": { "properties": { "kind": { "const": "transit" } } },
        "then": { "required": ["route_types"] },
        "additionalProperties": false
      }
    },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    }
  }
}
